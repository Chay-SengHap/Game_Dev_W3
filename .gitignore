# Unity .gitignore — Reduces repository size by excluding generated and cached files
# Only Assets, Packages, and ProjectSettings need to be tracked.

# Never commit these huge autogenerated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Studio / Rider / VSCode caches & solutions
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Builds & packages
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
